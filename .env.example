# Vorlage für lokale .env bzw. die Portainer-Stack-Variablen. NIE mit echten Werten committen.

# Domains (Produktion)
FP_HOST=formulare.example.com
FP_MCP_HOST=formulare-mcp.example.com
TRAEFIK_CERTRESOLVER=mydnschallenge

# Lokal
FP_PORT=8090
FP_MCP_PORT=8091
FP_PUBLIC_BASE_URL=http://localhost:8090

# Interner Schlüssel MCP-Container → Backend (lang und zufällig)
FP_INTERNAL_API_KEY=
# Bearer-Token für Claude Desktop/Code am MCP-Endpunkt
MCP_API_KEY=
# Authelia-OIDC für den claude.ai-Connector
OIDC_CLIENT_ID=formularportal-mcp
OIDC_CLIENT_SECRET=

# Kundenlinks laufen nach N Tagen ab (0 = nie)
FP_LINK_TTL_DAYS=120

# HERO (optional)
FP_HERO_TOKEN=
FP_HERO_AUTO_UPLOAD=false
FP_HERO_DOCUMENT_TYPE_ID=551120

# Mailversand (optional) – Benachrichtigung bei Einreichung + Link-Versand
FP_SMTP_HOST=
FP_SMTP_PORT=587
FP_SMTP_USER=
FP_SMTP_PASSWORD=
FP_SMTP_FROM=
FP_SMTP_SECURITY=starttls

# ntfy-Push (optional)
FP_NTFY_URL=
FP_NTFY_TOPIC=
FP_NTFY_TOKEN=
